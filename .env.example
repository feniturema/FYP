# Copy to .env and fill in. Never commit the real .env.

# ---- Database ----
DB_NAME=ftsm_ecommerce
DB_PASSWORD=changeme-strong-db-password

# ---- JWT (must be >= 32 chars) ----
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRY_MS=86400000

# ---- CORS (public origin of the SPA) ----
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.example

# ---- Email / OTP ----
# Set MAIL_ENABLED=true and provide SMTP creds to actually send OTP emails.
# When false, the OTP is printed in the backend logs (handy for dev).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=no-reply@ftsm.ukm.edu.my

# ---- Gemini (AI assistant) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Seed admin account ----
SEED_ADMIN_EMAIL=admin@ukm.edu.my
SEED_ADMIN_PASSWORD=Admin@123

# ---- Frontend ----
VITE_API_BASE_URL=/api
