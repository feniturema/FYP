# Copy to .env and fill in. Never commit the real .env.

# ---- Database ----
DB_NAME=ftsm_ecommerce
DB_PASSWORD=changeme-strong-db-password

# ---- JWT (must be >= 32 chars) ----
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRY_MS=86400000

# ---- CORS (public origin of the SPA) ----
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.example

# ---- Email / OTP ----
# Set MAIL_ENABLED=true and provide SMTP creds to actually send OTP emails.
# When false, the OTP is printed in the backend logs (handy for dev).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=no-reply@ftsm.ukm.edu.my

# ---- LLM / AI assistant (Spring AI) ----
# LLM_PROVIDER: none | deepseek. When unset it defaults to none and the assistant is OFF
# ("AI assistant is not configured yet."). deepseek with an empty LLM_API_KEY is also treated as none.
# Any other value stops the backend at startup.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Base URL without /v1 (Spring AI adds the path).
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek model options: deepseek-v4-flash (~5s, recommended) | deepseek-v4-pro (~13s, smarter)
#                         | deepseek-chat | deepseek-reasoner
LLM_MODEL=deepseek-v4-flash

# ---- MCP server (read-only catalogue tools for the assistant) ----
# Password of the read-only MySQL account ftsm_ro. Required: generate it with  openssl rand -hex 24
# (allowed characters: A-Z a-z 0-9 . _ ~ -, 24-128 long). It is applied by mysql/init/01-readonly-user.sh
# only when the mysql volume is created; for an existing volume see README "Upgrading to v0.10.0".
MCP_DB_PASSWORD=
# Host port of mcp-server, bound to 127.0.0.1 only (MCP Inspector, scripts/p4b/mcp_probe.py).
MCP_HOST_PORT=18082

# ---- Seed admin account ----
SEED_ADMIN_EMAIL=admin@ukm.edu.my
SEED_ADMIN_PASSWORD=Admin@123

# ---- Frontend ----
VITE_API_BASE_URL=/api
